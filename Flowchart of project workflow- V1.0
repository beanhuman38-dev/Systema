
flowchart TD
    USER["You — conversational AI"] --> AI["Gemini intelligence"]
    AI --> CORE["Systema control and rules"]
    CORE --> DATA["Systema data layer"]

    DATA --> GOALS["Goals and projects"]
    DATA --> ITEMS["Tasks and habits"]
